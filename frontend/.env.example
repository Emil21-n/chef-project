NEXT_PUBLIC_STRAPI_API_URL=https://your-strapi-instance.example.com
NEXT_PUBLIC_STRAPI_PUBLIC_URL=https://your-public-strapi-media.example.com
# Custom least-privilege token: read catalog/settings; create, find, and update orders.
STRAPI_API_TOKEN=your_remote_strapi_api_token
SITE_URL=https://chefschoice-turk.ru

# YooKassa server credentials. Never expose these variables with NEXT_PUBLIC_.
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RECEIPTS_ENABLED=true
# 1 = without VAT. Confirm this value with the restaurant accountant before production payments.
YOOKASSA_VAT_CODE=1
YOOKASSA_PAYMENT_MODE=full_payment
YOOKASSA_PAYMENT_SUBJECT=commodity

# Server-side order notifications. Never expose these variables with NEXT_PUBLIC_.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-mailbox@yandex.ru
SMTP_PASSWORD=your_yandex_app_password
ORDER_NOTIFICATION_EMAIL=orders@example.com
